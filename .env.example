# Paste your bot token after the = sign. Never commit or share this file.
DISCORD_TOKEN=

# Optional: your test server's ID. When set, slash commands sync to that
# server instantly instead of waiting for global propagation.
DEV_GUILD_ID=

# Optional: where the SQLite database lives.
DATABASE_PATH=valorant_bot.db

# Riot API key from https://developer.riotgames.com (dev keys expire every 24h).
RIOT_API_KEY=

# Riot account routing region: americas, europe, or asia.
RIOT_REGION=americas
